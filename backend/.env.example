# ---- Google / YouTube OAuth ----
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Meta / Instagram (fill when you set up Meta app) ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
META_API_VERSION=v25.0
# Use the Instagram App ID/secret under Instagram API setup with Instagram Login.

# ---- Admin auth ----
# Original admin login. Additional admins: python manage_user.py admin1 --admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# ---- App ----
FRONTEND_USER_ORIGIN=http://localhost:5173
FRONTEND_ADMIN_ORIGIN=http://localhost:5174
UPLOAD_DIR=uploads

# ---- Supabase Postgres database (required for table migration) ----
# Supabase dashboard -> Connect -> Session pooler -> copy the connection URI.
# Use the EXACT username and host from your project's Connect panel, port 5432.
# Replace PROJECT_REF, URL_ENCODED_DATABASE_PASSWORD, and SESSION_POOLER_HOST below.
# The database password is the project's Postgres password, NOT the service key.
# URL-encode special characters in the password (for example @ becomes %40).
# Keep sslmode=require. Do not include literal placeholder brackets.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Local SQLite alternative only (not Supabase):
# DATABASE_URL=sqlite:///./srisocials.db
# After updating backend/.env, run from backend:
# .venv/Scripts/python migrate_supabase.py
# Creates only srisocials_channel, srisocials_video, srisocials_teamuser,
# srisocials_adminuser, and srisocials_oauthattempt. Other projects' tables are left unchanged.

# ---- Hosting / private storage ----
ENVIRONMENT=development
PUBLIC_BACKEND_URL=http://localhost:8000
# Project URL and service_role key: Supabase project settings -> API / API Keys.
# These are for private video storage; they do NOT replace DATABASE_URL above.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=videos
# Use a private bucket dedicated to this app; change this name if videos is
# already used by the other project. Match the bucket name in the storage SQL.
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Preserve an existing TOKEN_ENCRYPTION_KEY if channel tokens were already saved.
# Required before production; shown on public policy pages.
OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# For Render: set ENVIRONMENT=production, replace PUBLIC_BACKEND_URL and both
# FRONTEND_*_ORIGIN values with deployed HTTPS origins (no trailing slash), and
# register the matching hosted GOOGLE_REDIRECT_URI / META_REDIRECT_URI callbacks.
# Use a 12+ character ADMIN_PASSWORD and random 32+ character ADMIN_SESSION_SECRET.
# Keep all database passwords, provider secrets and service keys backend-only.
# Copy missing settings into your existing .env; preserve credentials already set.
